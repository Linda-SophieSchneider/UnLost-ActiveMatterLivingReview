    given-names: Andreas
    email: andreas.maier@fau.de
    affiliation: Friedrich-Alexander-Universität Erlangen-Nürnberg
repository-code: "https://github.com/Linda-SophieSchneider/UnLost-ActiveMatterLivingReview"
url: "https://linda-sophie-schneider.de/UnLost-ActiveMatterLivingReview/"
license: CC-BY-4.0
keywords:
